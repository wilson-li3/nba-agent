# PostgreSQL connection URL. Create a database first, e.g. createdb nba
DATABASE_URL=postgresql://user:password@localhost:5432/nba

# OpenAI API key for LLM and embedding calls
OPENAI_API_KEY=sk-...

# ── Spend protection (see README) ──
RATE_LIMIT_CREDITS=40
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DAILY_CREDITS=600
DAILY_LLM_CALL_BUDGET=3000
DAILY_LLM_TOKEN_BUDGET=3000000
